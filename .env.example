# Copy this file to .env and fill it in. .env is git-ignored: never commit real keys.

ARGUS_LOG_LEVEL=INFO

# LLM access. The provider and models are not chosen yet.
ARGUS_LLM_MODEL=
ARGUS_LLM_API_KEY=

# Kubernetes: the context name of the disposable dev cluster.
# Scripts that change a cluster must refuse to run against any other context.
ARGUS_KUBE_CONTEXT=

# M3 sandbox limits (placeholders until we measure). If every M3 check fails with MemoryError,
# raise the memory cap; 256 was too small on some Linux machines.
ARGUS_SOLVER_TIMEOUT_S=5
ARGUS_SOLVER_MEMORY_MB=512

# M3's cluster facts. With no cluster (PP1), point this at saved kubectl output; leave it empty
# to read the live cluster in ARGUS_KUBE_CONTEXT instead.
ARGUS_M3_KUBECTL_OUTPUT=data/fixtures/m3/kubectl
