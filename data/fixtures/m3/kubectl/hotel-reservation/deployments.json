{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1", "kind": "Deployment",
      "metadata": {"name": "geo", "namespace": "hotel-reservation"},
      "spec": {
        "replicas": 3,
        "selector": {"matchLabels": {"app": "geo"}},
        "strategy": {"type": "RollingUpdate", "rollingUpdate": {"maxUnavailable": 1, "maxSurge": 1}},
        "template": {"metadata": {"labels": {"app": "geo"}}, "spec": {"containers": [{"name": "hotel-reserv-geo", "image": "deathstarbench/hotel-reservation:1.0"}]}}
      }
    },
    {
      "apiVersion": "apps/v1", "kind": "Deployment",
      "metadata": {"name": "frontend", "namespace": "hotel-reservation"},
      "spec": {
        "replicas": 2,
        "selector": {"matchLabels": {"app": "frontend"}},
        "strategy": {"type": "RollingUpdate", "rollingUpdate": {"maxUnavailable": 2, "maxSurge": 0}},
        "template": {"metadata": {"labels": {"app": "frontend"}}, "spec": {"containers": [{"name": "hotel-reserv-frontend", "image": "deathstarbench/hotel-reservation:1.0"}]}}
      }
    },
    {
      "apiVersion": "apps/v1", "kind": "Deployment",
      "metadata": {"name": "search", "namespace": "hotel-reservation"},
      "spec": {
        "replicas": 2,
        "selector": {"matchLabels": {"app": "search"}},
        "strategy": {"type": "RollingUpdate", "rollingUpdate": {"maxUnavailable": "25%", "maxSurge": "25%"}},
        "template": {"metadata": {"labels": {"app": "search"}}, "spec": {"containers": [{"name": "hotel-reserv-search", "image": "deathstarbench/hotel-reservation:1.0"}]}}
      }
    },
    {
      "apiVersion": "apps/v1", "kind": "Deployment",
      "metadata": {"name": "rate", "namespace": "hotel-reservation"},
      "spec": {
        "replicas": 0,
        "selector": {"matchLabels": {"app": "rate"}},
        "strategy": {"type": "RollingUpdate", "rollingUpdate": {"maxUnavailable": 1, "maxSurge": 1}},
        "template": {"metadata": {"labels": {"app": "rate"}}, "spec": {"containers": [{"name": "hotel-reserv-rate", "image": "deathstarbench/hotel-reservation:1.0"}]}}
      }
    },
    {
      "apiVersion": "apps/v1", "kind": "Deployment",
      "metadata": {"name": "profile", "namespace": "hotel-reservation"},
      "spec": {
        "replicas": 2,
        "selector": {"matchLabels": {"app": "profile"}},
        "strategy": {"type": "RollingUpdate", "rollingUpdate": {"maxUnavailable": "50%", "maxSurge": "25%"}},
        "template": {"metadata": {"labels": {"app": "profile"}}, "spec": {"containers": [{"name": "hotel-reserv-profile", "image": "deathstarbench/hotel-reservation:1.0"}]}}
      }
    },
    {
      "apiVersion": "apps/v1", "kind": "Deployment",
      "metadata": {"name": "mongodb-geo", "namespace": "hotel-reservation"},
      "spec": {
        "replicas": 1,
        "selector": {"matchLabels": {"app": "mongodb-geo"}},
        "strategy": {"type": "Recreate"},
        "template": {"metadata": {"labels": {"app": "mongodb-geo"}}, "spec": {"containers": [{"name": "hotel-reserv-geo-mongo", "image": "mongo:4.4"}], "volumes": [{"name": "geo-data", "persistentVolumeClaim": {"claimName": "geo-pvc"}}]}}
      }
    }
  ],
  "metadata": {"resourceVersion": ""}
}
